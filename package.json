{
  "name": "hak-scheduled-settlement",
  "version": "0.1.0",
  "description": "Hedera Agent Kit plugin for conditional settlement: pre-signed Scheduled Transactions released by a k-of-n attester quorum, with no smart contract and no keeper",
  "type": "module",
  "license": "MIT",
  "author": "Juanma Gomez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmgomezl/hak-scheduled-settlement.git"
  },
  "homepage": "https://github.com/jmgomezl/hak-scheduled-settlement#readme",
  "bugs": {
    "url": "https://github.com/jmgomezl/hak-scheduled-settlement/issues"
  },
  "keywords": [
    "hedera",
    "agent-kit",
    "plugin",
    "scheduled-transaction",
    "conditional-settlement",
    "threshold-key",
    "multisig",
    "escrow",
    "oracle-quorum"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration-test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@hashgraph/hedera-agent-kit": "^4.0.0",
    "@hiero-ledger/sdk": "^2.84.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@hashgraph/hedera-agent-kit": "^4.0.0",
    "@hiero-ledger/sdk": "^2.84.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
